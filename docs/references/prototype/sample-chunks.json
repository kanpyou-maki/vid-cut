[
 {
  "id": 0,
  "start": 8.197,
  "end": 11.288,
  "text": "前のレクチャーではパストラバーサロについて扱いました。"
 },
 {
  "id": 1,
  "start": 12.021,
  "end": 12.844,
  "text": "このレクチャーでは"
 },
 {
  "id": 2,
  "start": 13.229,
  "end": 18.123,
  "text": "更新される値そのものを書き換えられてしまう パラメータ改ざんというものを見ていきます"
 },
 {
  "id": 3,
  "start": 19.223,
  "end": 23.291,
  "text": "プライアントから送られてくる値 をそのまま信用して良いのかが分かる"
 },
 {
  "id": 4,
  "start": 24.673,
  "end": 25.449,
  "text": "クライアントから"
 },
 {
  "id": 5,
  "start": 27.371,
  "end": 29.071,
  "text": "クライアントから送られてくる値を"
 },
 {
  "id": 6,
  "start": 29.398,
  "end": 29.897,
  "text": "このまま…"
 },
 {
  "id": 7,
  "start": 33.979,
  "end": 39.746,
  "text": "クライアントから送られてくる 値をそのまま信用するのが危険 だということがよく分かるよう になります"
 },
 {
  "id": 8,
  "start": 45.929,
  "end": 48.413,
  "text": "まずは典型的な場面から見ていきましょう"
 },
 {
  "id": 9,
  "start": 49.474,
  "end": 51.348,
  "text": "買い物過後の合計金額が"
 },
 {
  "id": 10,
  "start": 51.673,
  "end": 52.275,
  "text": "URL..."
 },
 {
  "id": 11,
  "start": 53.379,
  "end": 58.956,
  "text": "買い物過後の合計金額がURLパラメーター やフォーブの秘伝項目に含まれ"
 },
 {
  "id": 12,
  "start": 59.454,
  "end": 62.748,
  "text": "そのままリクエストとして送信される作りになっているとします"
 },
 {
  "id": 13,
  "start": 64.261,
  "end": 68.666,
  "text": "ここでブラウザの開発者ツールやリクエストを編集できるツールを使い、"
 },
 {
  "id": 14,
  "start": 69.279,
  "end": 70.228,
  "text": "金額の値を比べる。"
 },
 {
  "id": 15,
  "start": 71.344,
  "end": 73.219,
  "text": "金額の値を書き換えてから創造します。"
 },
 {
  "id": 16,
  "start": 74.959,
  "end": 77.405,
  "text": "金額の値を書き換えてから送信すると"
 },
 {
  "id": 17,
  "start": 77.784,
  "end": 80.795,
  "text": "本来より安い金額で注文が通ってしまいます。"
 },
 {
  "id": 18,
  "start": 82.109,
  "end": 85.278,
  "text": "同じ仕組みが権限の値にも使われることがあります"
 },
 {
  "id": 19,
  "start": 90.232,
  "end": 95.675,
  "text": "例えば isAdmin=false のような値をリクエストに含めて送っている場合、"
 },
 {
  "id": 20,
  "start": 96.209,
  "end": 98.087,
  "text": "これをtrueに書き換えて送ると"
 },
 {
  "id": 21,
  "start": 98.433,
  "end": 101.465,
  "text": "管理者権限を持っているかのように扱われてしまいます"
 },
 {
  "id": 22,
  "start": 111.817,
  "end": 114.152,
  "text": "さらに具体的な場面を見ていきましょう"
 },
 {
  "id": 23,
  "start": 115.071,
  "end": 116.67,
  "text": "ECサイトの購入処理で"
 },
 {
  "id": 24,
  "start": 117.032,
  "end": 119.809,
  "text": "商品の価格をリクエストに含めて送信し、"
 },
 {
  "id": 25,
  "start": 120.21,
  "end": 123.902,
  "text": "サーバー側がその価格をそのまま 使って決済処理をしていたとします"
 },
 {
  "id": 26,
  "start": 125.149,
  "end": 129.322,
  "text": "攻撃者はリクエストの価格を1円 に書き換えてから送信します"
 },
 {
  "id": 27,
  "start": 130.308,
  "end": 136.235,
  "text": "サーバーは送られてきた金額を信じるため、1円の決済で商人を購入されてしまいます。"
 },
 {
  "id": 28,
  "start": 137.382,
  "end": 140.53,
  "text": "ここに共通しているのはクライアント から送られてくる値は"
 },
 {
  "id": 29,
  "start": 142.535,
  "end": 143.908,
  "text": "ここに共通しているのは"
 },
 {
  "id": 30,
  "start": 144.529,
  "end": 149.874,
  "text": "クライアントから送られてくる値は、 利用者の手でいくらでも書き換えられるという事実です。"
 },
 {
  "id": 31,
  "start": 153.398,
  "end": 156.038,
  "text": "フォームやURLに直接表示されていない。"
 },
 {
  "id": 32,
  "start": 156.472,
  "end": 156.65,
  "text": "-end-"
 },
 {
  "id": 33,
  "start": 158.451,
  "end": 158.905,
  "text": "思いや。"
 },
 {
  "id": 34,
  "start": 159.656,
  "end": 165.022,
  "text": "ホームやURLに直接表示されていないHidden項目や内部的な値であっても、"
 },
 {
  "id": 35,
  "start": 165.659,
  "end": 169.716,
  "text": "ブラウザ側で扱われるデータである以上 利用者の手が届いてしまいます"
 },
 {
  "id": 36,
  "start": 172.302,
  "end": 174.916,
  "text": "ブラウザ側で扱われるデータである以上"
 },
 {
  "id": 37,
  "start": 176.545,
  "end": 178.988,
  "text": "ブラウザ側で扱われるデータである以上です。"
 },
 {
  "id": 38,
  "start": 179.691,
  "end": 182.334,
  "text": "攻撃者が改ざんすることができてしまいます"
 },
 {
  "id": 39,
  "start": 191.744,
  "end": 192.941,
  "text": "対策を見ていきましょう"
 },
 {
  "id": 40,
  "start": 201.089,
  "end": 202.351,
  "text": "金額や権限など"
 },
 {
  "id": 41,
  "start": 202.764,
  "end": 206.521,
  "text": "重要な値は、クライアントからの申告をそのまま信用せず、"
 },
 {
  "id": 42,
  "start": 206.878,
  "end": 210.581,
  "text": "サーバー側で改めて計算検証するようにしましょう"
 },
 {
  "id": 43,
  "start": 211.599,
  "end": 215.448,
  "text": "例えば商品の価格はクライアント から贈られてきた値を使わず"
 },
 {
  "id": 44,
  "start": 215.984,
  "end": 220.452,
  "text": "カーバー側に保持されている商品マスターの価格を参照して計算しましょう。"
 },
 {
  "id": 45,
  "start": 222.05,
  "end": 223.427,
  "text": "権限についても同様に"
 },
 {
  "id": 46,
  "start": 223.936,
  "end": 226.617,
  "text": "クライアントが送ってきた値をそのまま使わず"
 },
 {
  "id": 47,
  "start": 226.933,
  "end": 228.856,
  "text": "サーバー側でログインチューノ ユーチューノ"
 },
 {
  "id": 48,
  "start": 249.048,
  "end": 250.61,
  "text": "権限についても同様で"
 },
 {
  "id": 49,
  "start": 251.169,
  "end": 252.013,
  "text": "クライアントから押し込みます"
 },
 {
  "id": 50,
  "start": 255.083,
  "end": 255.932,
  "text": "クライアントから"
 },
 {
  "id": 51,
  "start": 259.083,
  "end": 263.455,
  "text": "クライアント側から判定するための値を送信される仕組みではなく"
 },
 {
  "id": 52,
  "start": 263.852,
  "end": 268.967,
  "text": "サーバー側でログイン中のユーザー情報 から権限を確認するようにしましょう"
 },
 {
  "id": 53,
  "start": 298.807,
  "end": 300.457,
  "text": "このレクチャーを3点でまとめます。"
 },
 {
  "id": 54,
  "start": 301.185,
  "end": 301.53,
  "text": "1つ目"
 },
 {
  "id": 55,
  "start": 302.012,
  "end": 307.505,
  "text": "金額や権限を含む値がURLパラメーター やヒドゥン項目として送られている と"
 },
 {
  "id": 56,
  "start": 308.028,
  "end": 308.835,
  "text": "書き換えられて"
 },
 {
  "id": 57,
  "start": 309.156,
  "end": 313.209,
  "text": "税な金額や権限で処理されてしまう リスクがあるということ"
 },
 {
  "id": 58,
  "start": 314.632,
  "end": 314.961,
  "text": "2つ目"
 },
 {
  "id": 59,
  "start": 315.601,
  "end": 320.366,
  "text": "クライアントから送られてくる値 は利用者の手でいくらでも書き換え られてしまうこと"
 },
 {
  "id": 60,
  "start": 321.381,
  "end": 321.825,
  "text": "3つ目"
 },
 {
  "id": 61,
  "start": 322.437,
  "end": 327.757,
  "text": "対策は重要な値をクライアントの申告 のまま使わずサーバー側で改めて"
 },
 {
  "id": 62,
  "start": 328.153,
  "end": 329.08,
  "text": "計算・検証"
 },
 {
  "id": 63,
  "start": 329.861,
  "end": 330.651,
  "text": "するということを。"
 },
 {
  "id": 64,
  "start": 331.574,
  "end": 333.452,
  "text": "もしくはそもそもクライアント側"
 },
 {
  "id": 65,
  "start": 337.072,
  "end": 342.262,
  "text": "もしくはそもそもクライアントから送らせず サーバー側で値を取得するようにするということ"
 },
 {
  "id": 66,
  "start": 349.229,
  "end": 354.012,
  "text": "次のレクチャーでは、低レイヤーでおくバッファ・オーバーフローというものを見ていきます。"
 },
 {
  "id": 67,
  "start": 358.614,
  "end": 361.574,
  "text": "次のレクチャーでは、低レイヤーの中で発生する。"
 },
 {
  "id": 68,
  "start": 361.911,
  "end": 364.318,
  "text": "ワッファオーバーフローというものを見ていきます。"
 }
]