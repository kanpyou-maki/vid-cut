{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.ssh/*)",
      "Read(~/.aws/*)",
      "Read(~/.gnupg/*)",
      "Read(**/.env*)",
      "Read(**/credentials*)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Bash(curl * | bash)",
      "Bash(wget * | bash)",
      "Bash(rm -rf /*)",
      "Bash(ssh *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-bash-git-push-reminder.js"
          }
        ],
        "description": "git push 前に review-loop の確認をモデルに渡す"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/quality-gate.js",
            "async": true,
            "timeout": 30
          }
        ],
        "description": "ファイル編集後に、プロジェクトに設定のある整形ツールを実行（TypeScript/JS: Biome、なければ Prettier。Python: ruff）"
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/arch-lint.js"
          }
        ],
        "description": "ファイル編集後にアーキテクチャ規則違反を検出してモデルに伝える（ARCH-NNN）"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-typecheck.js"
          }
        ],
        "description": ".ts/.tsx 編集後に TypeScript 型チェックを実行し、エラーをモデルに伝える"
      }
    ]
  }
}
